# Copia este archivo a /home/ubuntu/obsidianx/.env en Oracle y rellena tus tokens
OBX_TG_TOKEN=TU_TOKEN_DE_BOTFATHER
OBX_TG_CHAT=@ObsidianX_OBX
OBX_TG_BLOCK_STEP=100
OBX_TG_MAX_SEC=43200

# Opcional: tu cuenta oficial de Mastodon (ej. https://mastodon.social)
OBX_MASTODON_URL=https://mastodon.social
OBX_MASTODON_TOKEN=TU_TOKEN_DE_MASTODON
OBX_SOCIAL_INTERVAL_S=86400